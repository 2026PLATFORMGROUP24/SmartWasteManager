<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base dark-green fill -->
    <path android:pathData="M0,0h108v108h-108z"
        android:fillColor="#1B5E20"/>

    <!-- Diagonal gradient overlay: lighter green top-left → transparent bottom-right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#6043A047"/>
                <item android:offset="1.0" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle radial highlight at top-center (simulated with a circle) -->
    <path android:pathData="M54,0 A54,54 0 0 1 108,54 L0,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#3066BB6A"/>
                <item android:offset="1.0" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
