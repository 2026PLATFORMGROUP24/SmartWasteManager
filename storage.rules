rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── AI Chat Images ────────────────────────────────────────────────────────
    // Each authenticated user can only read/write images under their own UID folder.
    // Path: ai_chat_images/{userId}/{filename}
    match /ai_chat_images/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── AI Model Files ────────────────────────────────────────────────────────
    // Any authenticated user may read model files (write is admin-only via console).
    // Path: ai_models/{filename}
    match /ai_models/{filename} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Guide Images ──────────────────────────────────────────────────────────
    // Any authenticated user can upload/read guide images.
    // Path: guide_images/{guideId}/{filename}
    match /guide_images/{guideId}/{filename} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Default: deny everything else ─────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

